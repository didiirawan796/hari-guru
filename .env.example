# Database PostgreSQL (Supabase/Neon/Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hari_guru

# Opsional, jumlah koneksi pool (default 10)
DATABASE_POOL_MAX=10

# Wajib minimal 32 karakter acak. Gunakan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Alamat WebSocket server
WS_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Secret untuk event internal dari web ke WS server
WS_INTERNAL_SECRET=ganti-dengan-secret-internal-acak

# WS server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Akun seed admin & operator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin-minimal-8
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=ganti-password-operator-minimal-8

# Akun sekolah contoh (opsional, untuk uji login sekolah)
SEED_SCHOOL_NAMA=SD Negeri Contoh
SEED_SCHOOL_USERNAME=sdn-contoh
SEED_SCHOOL_PASSWORD=ganti-password-sekolah
